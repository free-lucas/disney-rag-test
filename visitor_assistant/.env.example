# DeepSeek: answer generation, image understanding, query rewriting.
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# DashScope: text embeddings only (DeepSeek has no embedding endpoint).
DASHSCOPE_API_KEY=replace-with-your-dashscope-key
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_FALLBACK_MODEL=text-embedding-v1

# Paths are relative to this file's directory unless absolute.
DISNEY_KB_ROOT=../迪士尼RAG知识库（完整）
RAG_DATA_DIR=./data
RAG_INDEX_DIR=./data/index

# Retrieval and chunking. Keep values aligned with README.md.
RETRIEVAL_TOP_K=6
DENSE_TOP_K=20
BM25_TOP_K=20
RRF_K=60
DENSE_MIN_SCORE=0.25
RERANK_ENABLED=false
CHUNK_TARGET_CHARS=520
CHUNK_MIN_CHARS=400
CHUNK_MAX_CHARS=600
CHUNK_OVERLAP_CHARS=100

# Image captioning and cost controls.
IMAGE_MIN_WIDTH=180
IMAGE_MIN_HEIGHT=180
IMAGE_MIN_AREA=32400
IMAGE_MAX_PER_DOCUMENT=80
CAPTION_PROMPT_VERSION=v1

# Model request controls.
MODEL_TIMEOUT_SECONDS=90
MODEL_MAX_RETRIES=3
ANSWER_MAX_TOKENS=4000
REWRITE_MAX_TOKENS=500
